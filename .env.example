# Copy this file to .env and fill in real values. This file is loaded by the
# Express backend (server/index.js) via dotenv — NOT by Vite — so these keys
# stay server-side and are never bundled into the browser build.

# Anthropic (Claude) API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Places API key (enable "Places API (New)" or legacy Places API in
# Google Cloud Console, restrict it to your server's IP / referrer as needed)
# https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Port the Express backend listens on
PORT=8787

# Optional: override the base path the client uses for API calls.
# Defaults to "/api", which works with the Vite dev proxy and the
# production server both serving from the same origin.
VITE_API_BASE_URL=/api
