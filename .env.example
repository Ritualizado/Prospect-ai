# Copy this file to .env and fill in your key.
# Get an API key from https://console.anthropic.com/settings/keys
#
# NOTE: because this app calls the Anthropic API directly from the
# browser (see src/services/claudeApi.js), this key will be visible in
# your built JS bundle. That's fine for local dev / an internal tool
# behind auth, but do NOT ship this to a public production site without
# first moving the API call behind a backend proxy that holds the key
# server-side.

VITE_ANTHROPIC_API_KEY=your_api_key_here
